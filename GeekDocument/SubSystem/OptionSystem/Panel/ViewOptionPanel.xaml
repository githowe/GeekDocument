<UserControl x:Class="GeekDocument.SubSystem.OptionSystem.Panel.ViewOptionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeekDocument.SubSystem.OptionSystem.Panel"
             xmlns:wc="clr-namespace:XLogic.WpfControl;assembly=XLogic.WpfControl"
             mc:Ignorable="d" d:FontFamily="NSimSun"
             HorizontalAlignment="Left" VerticalAlignment="Top">
    <Grid>
        <StackPanel Margin="10" Orientation="Horizontal">
            <CheckBox x:Name="Check_PageBorder" Content="显示页面边框" Style="{StaticResource OnOff}" Width="140" HorizontalAlignment="Left"/>
            <CheckBox x:Name="Check_PaddingMark" Content="显示边距标记" Style="{StaticResource OnOff}" Width="140" HorizontalAlignment="Left" Margin="20,0,0,0"/>
            <CheckBox x:Name="Check_RowLine" Content="显示行线" Style="{StaticResource OnOff}" Width="140" HorizontalAlignment="Left" Margin="20,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>