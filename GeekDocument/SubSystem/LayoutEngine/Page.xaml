<UserControl x:Class="GeekDocument.SubSystem.LayoutEngine.Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GeekDocument.SubSystem.LayoutEngine"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Canvas x:Name="BlockBox"/>
        <Grid Background="Black" Height="64" VerticalAlignment="Top" Opacity="0.2" Margin="64,0"/>
        <Grid Background="Black" Width="64" HorizontalAlignment="Left" Opacity="0.2"/>
        <Grid Background="Black" Width="64" HorizontalAlignment="Right" Opacity="0.2"/>
    </Grid>
</UserControl>