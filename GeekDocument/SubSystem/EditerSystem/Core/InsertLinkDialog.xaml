<xw:XDialog x:Class="GeekDocument.SubSystem.EditerSystem.Core.InsertLinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeekDocument.SubSystem.EditerSystem.Core"
        xmlns:xw="clr-namespace:XLogic.Wpf.Window;assembly=XLogic.Wpf"
        xmlns:wc="clr-namespace:XLogic.WpfControl;assembly=XLogic.WpfControl"
        mc:Ignorable="d" WindowStartupLocation="CenterOwner"
        Style="{StaticResource NormalDialog}" ShowInTaskbar="False"
        FontFamily="../../../Assets/Font/#新宋体" CustomIcon="WindowIcon/Link"
        Title="插入链接" SizeToContent="Height" Width="500">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="10">
            <wc:FrameLabel Text="路径" Grid.Row="4" Height="21"/>
            <TextBox x:Name="Input_Url" Height="25" Margin="0,10,0,0"/>
            <Button x:Name="OK" Grid.Row="10" Height="25" Style="{StaticResource ConfirmButton}" IsDefault="True" Content="确定" Margin="0,10,0,0" Click="OK_Click"/>
        </StackPanel>
    </Grid>
</xw:XDialog>