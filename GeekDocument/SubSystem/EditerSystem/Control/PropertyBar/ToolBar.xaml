<local:PropertyBarBase x:Class="GeekDocument.SubSystem.EditerSystem.Control.PropertyBar.ToolBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GeekDocument.SubSystem.EditerSystem.Control.PropertyBar"
             mc:Ignorable="d" 
             d:DesignWidth="320" Height="25">
    <Grid x:Name="MainGrid" Background="Transparent" MouseEnter="MainGrid_MouseEnter" MouseLeave="MainGrid_MouseLeave">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Block_Title" Text="标题" Foreground="#8C8C8C" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <StackPanel x:Name="Stack_ToolList" Grid.Column="1" Orientation="Horizontal"/>
    </Grid>
</local:PropertyBarBase>